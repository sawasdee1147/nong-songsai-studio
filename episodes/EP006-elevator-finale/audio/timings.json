  "lines": [
    {
      "index": 1,
      "text": "ตีสองยี่สิบห้า เสียงเคาะใต้เท้าคุณ!",
      "start": 0.0,
      "end": 2.508,
      "duration": 2.508,
      "gain_db": -0.42
    },
    {
      "index": 2,
      "text": "ข้างบนมีชายแปลกหน้า แล้วข้างล่างล่ะ?",
      "start": 2.714,
      "end": 5.505,
      "duration": 2.791,
      "gain_db": -0.08,
      "gap_before": 0.206
    },
    {
      "index": 3,
      "text": "คุณกดกริ่งฉุกเฉิน ไม่มีใครตอบ!",
      "start": 5.708,
      "end": 7.618,
      "duration": 1.91,
      "gain_db": -2.0,
      "gap_before": 0.203
    },
    {
      "index": 4,
      "text": "คุณเลยรีบกดปุ่มชั้นรัวๆ!",
      "start": 7.831,
      "end": 9.536,
      "duration": 1.704,
      "gain_db": -4.5,
      "gap_before": 0.213
    },
    {
      "index": 5,
      "text": "หยุด! ลุงยามเอง อย่ากดนะ!",
