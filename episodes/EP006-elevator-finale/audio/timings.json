      "end": 19.654,
      "duration": 2.97,
      "speaker": "Y",
      "radio": true,
      "gain_db": -1.0,
      "gap_before": 0.201
    },
    {
      "index": 9,
      "text": "พอเปิด ปุ่มชั้นในลิฟต์ก็ใช้ไม่ได้!",
      "start": 19.864,
      "end": 22.107,
      "duration": 2.242,
      "speaker": "Y",
      "radio": true,
      "gain_db": 0.28,
      "gap_before": 0.21
    },
    {
      "index": 10,
      "text": "เคาะบอกช่างข้างล่าง ว่าคุณยังโอเค!",
      "start": 22.308,
      "end": 24.915,
      "duration": 2.608,
      "speaker": "Y",
      "radio": true,
      "gain_db": -1.0,
      "gap_before": 0.201
    },
    {
      "index": 11,
      "text": "คุณเคาะพื้นตอบ ก๊อก ก๊อก!",
