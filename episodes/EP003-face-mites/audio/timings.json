      "end": 5.095,
      "duration": 2.24,
      "gap_before": 0.206
    },
    {
      "index": 3,
      "text": "ล้างหน้าแล้วก็ยังคัน!",
      "start": 5.298,
      "end": 6.628,
      "duration": 1.33,
