  "lines": [
    {
      "index": 1,
      "text": "ตีสาม คุณตื่นมาเพราะขนตาคันยิบๆ!",
      "start": 0.0,
      "end": 2.8,
      "duration": 2.8
    },
    {
      "index": 2,
      "text": "ต้องเป็นเตียงสกปรกแน่ๆ!",
      "start": 3.006,
      "end": 4.506,
      "duration": 1.5,
      "gap_before": 0.206
    },
    {
      "index": 3,
      "text": "รีบเปลี่ยนปลอกหมอน แล้วไปล้างหน้า!",
      "start": 4.709,
      "end": 6.666,
      "duration": 1.957,
      "gap_before": 0.203
    },
    {
      "index": 4,
      "text": "กลับมานอน ก็ยังคันเหมือนเดิม!",
      "start": 6.879,
      "end": 9.194,
      "duration": 2.315,
      "gap_before": 0.213
    },
    {
      "index": 5,
      "text": "แต่เดี๋ยวก่อน… มีเรื่องที่คุณยังไม่รู้!",
      "start": 9.395,
      "end": 11.735,
      "duration": 2.34,
      "gap_before": 0.201
    },
    {
      "index": 6,
      "text": "ลองดูใกล้ๆ… บนหน้าคนเรามีผู้อาศัยอยู่!",
      "start": 11.946,
      "end": 15.41,
      "duration": 3.464,
      "gap_before": 0.211
    },
    {
      "index": 7,
      "text": "ไรจิ๋วอาศัยอยู่ในรูขุมขนบนหน้า!",
      "start": 15.617,
      "end": 18.487,
      "duration": 2.87,
      "gap_before": 0.207
    },
    {
      "index": 8,
      "text": "ตัวยาวไม่ถึงครึ่งมิลลิเมตร!",
      "start": 18.688,
      "end": 20.478,
      "duration": 1.79,
      "gap_before": 0.201
    },
    {
      "index": 9,
      "text": "ตาเปล่ามองไม่เห็น ตัวโปร่งแสง มีแปดขา!",
      "start": 20.688,
      "end": 24.438,
      "duration": 3.75,
      "gap_before": 0.21
    },
    {
      "index": 10,
      "text": "มันกินน้ำมันผิวกับเซลล์ผิวคุณ!",
      "start": 24.639,
      "end": 27.254,
      "duration": 2.615,
      "gap_before": 0.201
    },
    {
      "index": 11,
      "text": "นักวิจัยเชื่อว่า ตอนคุณหลับ มันหาคู่!",
      "start": 27.463,
      "end": 30.536,
      "duration": 3.073,
      "gap_before": 0.209
    },
    {
      "index": 12,
      "text": "นักวิจัยตรวจดีเอ็นเอผู้ใหญ่สิบเก้าคน!",
      "start": 30.737,
      "end": 33.685,
      "duration": 2.948,
      "gap_before": 0.201
    },
    {
      "index": 13,
      "text": "เจอดีเอ็นเอไร ครบทั้งสิบเก้าคน!",
      "start": 33.887,
      "end": 36.377,
      "duration": 2.49,
      "gap_before": 0.202
    },
    {
      "index": 14,
      "text": "ส่องกล้องหาตัว เจอแค่สิบสี่เปอร์เซ็นต์!",
      "start": 36.585,
      "end": 39.695,
      "duration": 3.11,
      "gap_before": 0.208
    },
    {
      "index": 15,
      "text": "ดีเอ็นเอบอกว่า แทบทุกคนมี!",
      "start": 39.912,
      "end": 42.315,
      "duration": 2.403,
      "gap_before": 0.217
    },
    {
      "index": 16,
      "text": "ไม่ใช่เรื่องหน้าสกปรกนะ!",
      "start": 42.517,
      "end": 43.927,
      "duration": 1.41,
      "gap_before": 0.202
    },
    {
      "index": 17,
      "text": "มีเรื่องเล่าว่า ไรไม่มีรูทวาร!",
      "start": 44.131,
      "end": 47.345,
      "duration": 3.214,
      "gap_before": 0.204
    },
    {
      "index": 18,
      "text": "ตายแล้วของเสียทะลักใส่หน้า!",
      "start": 47.558,
      "end": 49.698,
      "duration": 2.14,
      "gap_before": 0.213
    },
    {
      "index": 19,
      "text": "แต่งานวิจัยปีสองพันยี่สิบสอง บอกว่าผิด!",
      "start": 49.917,
      "end": 53.367,
      "duration": 3.45,
      "gap_before": 0.219
    },
    {
      "index": 20,
      "text": "ไรมีรูทวาร เป็นท่อจิ๋วเปิดออกข้างนอก!",
      "start": 53.579,
      "end": 57.199,
      "duration": 3.62,
      "gap_before": 0.212
    },
    {
      "index": 21,
      "text": "ขอโทษนะปลอกหมอน ที่หาว่าสกปรก!",
      "start": 57.407,
      "end": 60.057,
      "duration": 2.65,
      "gap_before": 0.208
    },
    {
      "index": 22,
      "text": "ส่วนคืนนั้นคันเพราะอะไร ก็ยังไม่รู้นะ!",
      "start": 60.277,
      "end": 63.214,
      "duration": 2.937,
      "gap_before": 0.22
    },
    {
      "index": 23,
      "text": "ส่วนใหญ่มันไม่ก่ออาการอะไรเลย!",
      "start": 63.415,
      "end": 65.245,
      "duration": 1.83,
      "gap_before": 0.201
    },
    {
      "index": 24,
      "text": "แต่ถ้าคันตา เปลือกตาแดง หรือมีผื่นนานๆ…",
      "start": 65.462,
      "end": 68.506,
      "duration": 3.044,
      "gap_before": 0.217
    },
    {
      "index": 25,
      "text": "ให้ไปหาหมอนะ!",
      "start": 68.712,
      "end": 69.812,
      "duration": 1.1,
      "gap_before": 0.206
    },
    {
      "index": 26,
      "text": "รู้เรื่องทั้งหมดแล้ว!",
      "start": 70.015,
      "end": 71.255,
      "duration": 1.24,
      "gap_before": 0.203
    },
    {
