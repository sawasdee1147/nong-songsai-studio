  "lines": [
    {
      "index": 1,
      "text": "ตีสองสิบนาที คุณอยู่ในลิฟต์!",
      "start": 0.0,
      "end": 2.161,
      "duration": 2.161
    },
    {
      "index": 2,
      "text": "แล้วไฟก็ดับ ลิฟต์กระตุกอย่างแรง!",
      "start": 2.367,
      "end": 4.758,
      "duration": 2.391,
      "gap_before": 0.206
    },
    {
      "index": 3,
      "text": "เหล็กครูดดัง ลิฟต์ค้างระหว่างชั้นเจ็ดกับแปด!",
      "start": 4.961,
      "end": 7.941,
      "duration": 2.98,
      "gap_before": 0.203
    },
    {
      "index": 4,
      "text": "บนเพดานลิฟต์ มีช่องหลังคา…",
      "start": 8.154,
      "end": 10.465,
      "duration": 2.31,
      "gap_before": 0.213
    },
    {
      "index": 5,
      "text": "คุณอยากปีนหนีไหม?",
      "start": 10.666,
      "end": 11.906,
      "duration": 1.24,
      "gap_before": 0.201
    },
    {
      "index": 6,
      "text": "อย่าปีนออกช่องนั้น! อย่างัดประตูด้วย!",
      "start": 12.117,
      "end": 14.487,
      "duration": 2.37,
      "gap_before": 0.211
    },
    {
      "index": 7,
      "text": "ทำไมถึงห้ามน่ะเหรอ?",
      "start": 14.694,
      "end": 15.724,
      "duration": 1.03,
      "gap_before": 0.207
    },
    {
      "index": 8,
      "text": "เพราะลิฟต์ไม่ได้อันตราย อย่างที่คุณกลัว!",
      "start": 15.925,
      "end": 18.609,
      "duration": 2.685,
      "gap_before": 0.201
    },
    {
      "index": 9,
      "text": "ลิฟต์ห้อยด้วยสายเหล็กหลายเส้น!",
      "start": 18.819,
      "end": 20.645,
      "duration": 1.826,
      "gap_before": 0.21
    },
    {
      "index": 10,
      "text": "สายแค่เส้นเดียว ก็แบกลิฟต์เต็มคันได้แล้ว!",
      "start": 20.846,
      "end": 23.596,
      "duration": 2.75,
      "gap_before": 0.201
    },
    {
      "index": 11,
      "text": "คุณเริ่มใจชื้นขึ้นมานิดหนึ่ง!",
      "start": 23.805,
      "end": 25.7,
      "duration": 1.896,
      "gap_before": 0.209
    },
    {
      "index": 12,
      "text": "ตอนไฟดับ เบรกที่มอเตอร์ลิฟต์จะงับเอง!",
      "start": 25.901,
      "end": 28.613,
      "duration": 2.711,
      "gap_before": 0.201
    },
    {
      "index": 13,
      "text": "สรุปคือ ลิฟต์แทบไม่มีทางร่วงอิสระ!",
      "start": 28.815,
      "end": 31.345,
      "duration": 2.53,
      "gap_before": 0.202
    },
    {
      "index": 14,
      "text": "งั้นรออยู่ข้างในลิฟต์ ดีกว่าปีนออกไปเสี่ยง!",
      "start": 31.553,
      "end": 34.063,
      "duration": 2.51,
      "gap_before": 0.208
    },
    {
      "index": 15,
      "text": "อีกอย่าง กดปุ่มระฆังเรียกคนช่วย!",
      "start": 34.28,
      "end": 36.858,
      "duration": 2.578,
      "gap_before": 0.217
    },
    {
      "index": 16,
      "text": "คุณกดปุ่มระฆัง… แต่ยังไม่มีใครตอบเลย!",
      "start": 37.06,
      "end": 39.659,
      "duration": 2.599,
      "gap_before": 0.202
    },
    {
      "index": 17,
      "text": "ตีสองยี่สิบแล้ว ไฟฉุกเฉินก็เริ่มกะพริบ!",
      "start": 39.863,
      "end": 42.691,
      "duration": 2.828,
      "gap_before": 0.204
    },
    {
      "index": 18,
      "text": "แต่คืนนี้ ยังมีเรื่องที่น่ากลัวกว่านั้น!",
      "start": 42.904,
      "end": 45.812,
      "duration": 2.908,
      "gap_before": 0.213
    },
    {
      "index": 19,
      "text": "ก๊อก ก๊อก ก๊อก… มีใครเคาะอยู่บนหลังคาลิฟต์!",
      "start": 46.031,
      "end": 48.589,
      "duration": 2.558,
      "gap_before": 0.219
    },
    {
      "index": 20,
      "text": "แล้วไฟฉายก็ส่องลงมาจากช่องหลังคา!",
      "start": 48.801,
      "end": 51.478,
      "duration": 2.677,
      "gap_before": 0.212
    },
    {
      "index": 21,
      "text": "แล้วหน้าลุงยามคนหนึ่ง ก็โผล่มาจ้องคุณ!",
      "start": 51.686,
      "end": 54.373,
      "duration": 2.686,
      "gap_before": 0.208
    },
    {
      "index": 22,
      "text": "แต่คุณรู้ดีว่า…",
      "start": 54.593,
      "end": 55.713,
      "duration": 1.12,
      "gap_before": 0.22
    },
    {
      "index": 23,
      "text": "คอนโดนี้ไม่มียาม!",
      "start": 55.914,
      "end": 57.286,
      "duration": 1.373,
      "gap_before": 0.201
    },
    {
      "index": 24,
      "text": "ไม่มีมาสิบปีแล้ว!",
      "start": 57.503,
      "end": 58.893,
      "duration": 1.39,
      "gap_before": 0.217
    },
    {
      "index": 25,
      "text": "แล้วลุงคนนี้ใครกัน?",
      "start": 59.099,
      "end": 60.399,
