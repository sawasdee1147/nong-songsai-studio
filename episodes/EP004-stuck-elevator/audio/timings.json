  "lines": [
    {
      "index": 1,
      "text": "ตีสองสิบนาที คุณอยู่ในลิฟต์!",
      "start": 0.0,
      "end": 2.168,
      "duration": 2.168
    },
    {
      "index": 2,
      "text": "แล้วไฟก็ดับ ลิฟต์กระตุกอย่างแรง!",
      "start": 2.374,
      "end": 4.765,
      "duration": 2.391,
      "gap_before": 0.206
    },
    {
      "index": 3,
      "text": "เหล็กครูดดัง ลิฟต์ค้างระหว่างชั้นเจ็ดกับแปด!",
      "start": 4.968,
      "end": 7.948,
      "duration": 2.98,
      "gap_before": 0.203
    },
    {
      "index": 4,
      "text": "บนเพดานลิฟต์ มีช่องหลังคา…",
      "start": 8.161,
      "end": 10.49,
      "duration": 2.329,
      "gap_before": 0.213
    },
    {
      "index": 5,
      "text": "คุณอยากปีนหนีไหม?",
      "start": 10.691,
      "end": 11.911,
      "duration": 1.22,
      "gap_before": 0.201
    },
    {
      "index": 6,
      "text": "อย่าปีนออกช่องนั้น! อย่างัดประตูด้วย!",
      "start": 12.122,
      "end": 14.502,
      "duration": 2.38,
      "gap_before": 0.211
    },
    {
      "index": 7,
      "text": "ทำไมถึงห้ามน่ะเหรอ?",
      "start": 14.709,
      "end": 15.739,
      "duration": 1.03,
      "gap_before": 0.207
    },
    {
      "index": 8,
      "text": "เพราะลิฟต์ไม่ได้อันตราย อย่างที่คุณกลัว!",
      "start": 15.94,
      "end": 18.623,
      "duration": 2.683,
      "gap_before": 0.201
    },
    {
      "index": 9,
      "text": "ลิฟต์ห้อยด้วยสายเหล็กหลายเส้น!",
      "start": 18.833,
      "end": 20.658,
      "duration": 1.825,
      "gap_before": 0.21
    },
    {
      "index": 10,
      "text": "สายแค่เส้นเดียว ก็แบกลิฟต์เต็มคันได้แล้ว!",
      "start": 20.859,
      "end": 23.618,
      "duration": 2.759,
      "gap_before": 0.201
    },
    {
      "index": 11,
      "text": "คุณเริ่มใจชื้นขึ้นมานิดหนึ่ง!",
      "start": 23.827,
      "end": 25.721,
      "duration": 1.894,
      "gap_before": 0.209
    },
    {
      "index": 12,
      "text": "ตอนไฟดับ เบรกที่มอเตอร์ลิฟต์จะงับเอง!",
      "start": 25.922,
      "end": 28.64,
      "duration": 2.718,
      "gap_before": 0.201
    },
    {
      "index": 13,
      "text": "สรุปคือ ลิฟต์แทบไม่มีทางร่วงอิสระ!",
      "start": 28.842,
      "end": 31.382,
      "duration": 2.54,
      "gap_before": 0.202
    },
    {
      "index": 14,
      "text": "งั้นรออยู่ข้างในลิฟต์ ดีกว่าปีนออกไปเสี่ยง!",
      "start": 31.59,
      "end": 34.1,
      "duration": 2.51,
      "gap_before": 0.208
    },
    {
      "index": 15,
      "text": "อีกอย่าง กดปุ่มระฆังเรียกคนช่วย!",
      "start": 34.317,
      "end": 36.905,
      "duration": 2.588,
      "gap_before": 0.217
    },
    {
      "index": 16,
      "text": "คุณกดปุ่มระฆัง… แต่ยังไม่มีใครตอบเลย!",
      "start": 37.107,
      "end": 39.702,
      "duration": 2.596,
      "gap_before": 0.202
    },
    {
      "index": 17,
      "text": "ตีสองยี่สิบแล้ว ไฟฉุกเฉินก็เริ่มกะพริบ!",
      "start": 39.906,
      "end": 42.727,
      "duration": 2.821,
      "gap_before": 0.204
    },
    {
      "index": 18,
      "text": "แต่คืนนี้ ยังมีเรื่องที่น่ากลัวกว่านั้น!",
      "start": 42.94,
      "end": 45.849,
      "duration": 2.909,
      "gap_before": 0.213
    },
    {
      "index": 19,
      "text": "ก๊อก ก๊อก ก๊อก… มีใครเคาะอยู่บนหลังคาลิฟต์!",
      "start": 46.068,
      "end": 48.623,
      "duration": 2.556,
      "gap_before": 0.219
    },
    {
      "index": 20,
      "text": "แล้วไฟฉายก็ส่องลงมาจากช่องหลังคา!",
      "start": 48.835,
      "end": 51.506,
      "duration": 2.67,
      "gap_before": 0.212
    },
    {
      "index": 21,
      "text": "แล้วหน้าลุงยามคนหนึ่ง ก็โผล่มาจ้องคุณ!",
      "start": 51.714,
      "end": 54.399,
      "duration": 2.685,
      "gap_before": 0.208
    },
    {
      "index": 22,
      "text": "แต่คุณรู้ดีว่า…",
      "start": 54.619,
      "end": 55.729,
      "duration": 1.11,
      "gap_before": 0.22
    },
    {
      "index": 23,
      "text": "คอนโดนี้ไม่มียาม!",
      "start": 55.93,
      "end": 57.305,
      "duration": 1.374,
      "gap_before": 0.201
    },
    {
      "index": 24,
      "text": "ไม่มีมาสิบปีแล้ว!",
      "start": 57.522,
      "end": 58.942,
      "duration": 1.42,
      "gap_before": 0.217
    },
    {
      "index": 25,
      "text": "แล้วลุงคนนี้ใครกัน?",
      "start": 59.148,
      "end": 60.438,
