  "lines": [
    {
      "index": 1,
      "text": "ตีสองสิบนาที คุณอยู่ในลิฟต์!",
      "start": 0.0,
      "end": 2.168,
      "duration": 2.168,
      "gain_db": 0.3
    },
    {
      "index": 2,
      "text": "แล้วไฟก็ดับ ลิฟต์กระตุกอย่างแรง!",
      "start": 2.374,
      "end": 4.765,
      "duration": 2.391,
      "gain_db": -0.1,
      "gap_before": 0.206
    },
    {
      "index": 3,
      "text": "เหล็กครูดดัง ลิฟต์ค้างระหว่างชั้นเจ็ดกับแปด!",
      "start": 4.968,
      "end": 7.948,
      "duration": 2.98,
      "gain_db": -0.1,
      "gap_before": 0.203
    },
    {
      "index": 4,
      "text": "บนเพดานลิฟต์ มีช่องหลังคา…",
      "start": 8.161,
      "end": 10.49,
      "duration": 2.329,
      "gain_db": -0.6,
      "gap_before": 0.213
    },
    {
      "index": 5,
      "text": "คุณอยากปีนหนีไหม?",
      "start": 10.691,
      "end": 11.911,
      "duration": 1.22,
      "gain_db": -0.6,
      "gap_before": 0.201
    },
    {
      "index": 6,
      "text": "แล้วลำโพงในลิฟต์ ก็ดังขึ้นมาเอง!",
      "start": 12.122,
      "end": 14.762,
      "duration": 2.64,
      "gain_db": -2.0,
      "gap_before": 0.211
    },
    {
      "index": 7,
      "text": "อย่าปีนออกช่องนั้นนะ! อย่างัดประตูด้วย!",
      "start": 14.969,
      "end": 17.794,
      "duration": 2.825,
      "speaker": "Y",
      "radio": true,
      "gain_db": -1.0,
      "gap_before": 0.207
    },
    {
      "index": 8,
      "text": "เฮ้ย! รู้ได้ไงว่าคุณจะปีน?",
      "start": 17.995,
      "end": 19.715,
      "duration": 1.72,
      "gain_db": -4.1,
      "gap_before": 0.201
    },
    {
      "index": 9,
      "text": "แต่ช่างมันก่อน ทำไมถึงห้ามน่ะเหรอ?",
      "start": 19.925,
      "end": 22.065,
      "duration": 2.14,
      "gain_db": 1.2,
      "gap_before": 0.21
    },
    {
      "index": 10,
      "text": "เพราะลิฟต์ไม่ได้อันตราย อย่างที่คุณกลัว!",
      "start": 22.266,
      "end": 24.949,
      "duration": 2.683,
      "gain_db": 0.0,
      "gap_before": 0.201
    },
    {
      "index": 11,
      "text": "ลิฟต์ห้อยด้วยสายเหล็กหลายเส้น!",
      "start": 25.158,
      "end": 26.983,
      "duration": 1.825,
      "gain_db": 0.2,
      "gap_before": 0.209
    },
    {
      "index": 12,
      "text": "สายแค่เส้นเดียว ก็แบกลิฟต์เต็มคันได้แล้ว!",
      "start": 27.184,
      "end": 29.944,
      "duration": 2.759,
      "gain_db": -0.57,
      "gap_before": 0.201
    },
    {
      "index": 13,
      "text": "คุณเริ่มใจชื้นขึ้นมานิดหนึ่ง!",
      "start": 30.146,
      "end": 32.039,
      "duration": 1.894,
      "gain_db": 0.1,
      "gap_before": 0.202
    },
    {
      "index": 14,
      "text": "ตอนไฟดับ เบรกที่มอเตอร์ลิฟต์จะงับเอง!",
      "start": 32.247,
      "end": 34.965,
      "duration": 2.718,
      "gain_db": -0.18,
      "gap_before": 0.208
    },
    {
      "index": 15,
      "text": "สรุปคือ ลิฟต์แทบไม่มีทางร่วง!",
